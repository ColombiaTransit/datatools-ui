    "react-dom": "18.3.1",
    "react-dropdown-tree-select": "^2.5.1",
    "react-dropzone": "^3.5.3",
    "react-flip-move": "^3.0.4",
    "react-ga": "^2.3.5",
    "react-leaflet": "4.2.1",
    "react-pure-render": "^1.0.2",
    "react-redux": "9.2.0",
    "react-router-bootstrap": "0.26.3",
    "react-router-dom": "6.30.6",
    "react-select": "1.x",
    "react-toastify": "^5.1.0",
    "react-toggle": "^4.1.2",
