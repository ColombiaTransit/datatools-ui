    "babel-jest": "^24.8.0",
    "babel-plugin-syntax-hermes-parser": "^0.32.1",
    "cross-env": "^5.2.0",
    "esbuild-plugin-yaml": "^0.0.1",
    "eslint": "^5.15.1",
    "eslint-config-standard": "^12.0.0",
    "eslint-config-standard-jsx": "^6.0.2",
    "eslint-plugin-flowtype": "^3.4.2",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jest": "^22.3.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-react": "^7.12.4",
    "eslint-plugin-standard": "^4.0.0",
    "execa": "^2.0.4",
    "express": "^4.16.4",
    "express-http-proxy": "^1.5.1",
    "extract-zip": "^1.6.7",
    "flow-bin": "0.84",
    "flow-coverage-report": "^0.3.0",
    "fs-extra": "^6.0.1",
    "husky": "^6.0.0",
    "istanbul-middleware": "^0.2.2",
    "jest": "^24.1.0",
    "jest-environment-node": "^24.8.0",
    "js-yaml": "^3.11.0",
    "jsdom": "26.1.0",
    "lint-staged": "^11.0.0",
    "md5-file": "^4.0.0",
    "nock": "^13.5.6",
    "patch-package": "^6.4.7",
    "puppeteer-screen-recorder": "^2.1.0",
    "request": "^2.88.0",
    "semantic-release": "^17.2.3",
    "simple-node-logger": "^0.93.37",
    "slack": "^11.0.1",
    "this-commit": "^1.0.0",
    "vite": "^7.3.7",
    "vite-plugin-babel": "^1.3.2",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "3.2.6"
  },
  "resolutions": {
    "react-overlays": "0.9.3"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "standard": {
    "env": [
      "jest"
    ],
    "parser": "babel-eslint",
    "globals": [
      "$Diff",
      "$Keys",
      "$Values",
      "Blob",
      "ClipboardEvent",
      "File",
      "IntervalID",
      "HTMLCanvasElement",
      "HTMLElement",
      "HTMLInputElement",
      "KeyboardEvent",
      "MouseEvent",
      "ReactComponent",
      "ReactElement",
      "Response",
      "SyntheticEvent",
      "SyntheticClipboardEvent",
      "SyntheticCompositionEvent",
      "SyntheticInputEvent",
      "SyntheticUIEvent",
      "SyntheticFocusEvent",
      "SyntheticKeyboardEvent",
      "SyntheticMouseEvent",
      "SyntheticDragEvent",
      "SyntheticWheelEvent",
      "SyntheticTouchEvent"
    ]
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all"
  ]
}
