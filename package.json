{
  "name": "datatools-manager",
  "version": "0.0.0-development",
  "description": "Core application for the IBI Group transit data tools suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColombiaTransit/datatools-ui.git"
  },
  "author": "Conveyal LLC, IBI Group",
  "license": "MIT",
  "scripts": {
    "add-husky": "husky install",
    "build": "patch-package && vite build",
    "build-e2e": "env YAML_CONFIG=configurations/default/env.yml vite build",
    "cover-client": "npm run test-client -- --coverage",
    "cover-flow": "flow-coverage-report -t html -t text -i 'lib/**/*.js' -o coverage-flow",
    "cover-end-to-end": "cross-env COLLECT_COVERAGE=true npm run test-end-to-end",
    "deploy": "sh scripts/deploy-static.sh",
    "e2e-preview": "vite preview",
    "flow": "flow status",
    "import-mobility-data": "wget https://github.com/MobilityData/gtfs-validator/releases/download/v8.0.1/gtfs-validator-8.0.1-cli.jar && java -jar gtfs-validator-8.0.1-cli.jar -n -o ./lib/manager/components/validation/ && rm ./lib/manager/components/validation/rules.json && mv ./lib/manager/components/validation/notice_schema.json ./lib/manager/components/validation/rules.json",
    "lint": "eslint __tests__ lib scripts --quiet",
    "lint-messages": "node scripts/lint-messages.js",
    "semantic-release": "semantic-release --prepare false --publish @semantic-release/github --verify-conditions @semantic-release/github",
    "start": "yarn && patch-package && vite",
    "test": "npm run lint && npm run lint-messages && yarn run flow && npm run test-client",
    "test-client": "TZ=America/Los_Angeles vitest run",
    "test-end-to-end": "jest --config jest.e2e.config.js --runInBand --json --outputFile e2e-test-results/results.json"
  },
  "dependencies": {
    "@auth0/auth0-react": "^1.10.2",
    "@conveyal/lonlat": "^1.3.0",
    "@react-leaflet/core": "2.1.0",
    "@turf/along": "^5.1.5",
    "@turf/area": "^6.0.1",
    "@turf/center-of-mass": "^7.0.0",
    "@turf/distance": "^5.1.5",
    "@turf/line-slice-along": "^4.6.0",
    "@turf/nearest-point-on-line": "^5.1.5",
    "bootstrap": "^3.4.1",
    "bugsnag-js": "^4.7.2",
    "bugsnag-react": "^1.1.1",
    "common-tags": "^1.6.0",
    "dom-helpers": "3.2.1",
    "fast-csv": "^4.3.6",
    "file-saver": "^1.3.8",
    "font-awesome": "^4.7.0",
    "gravatar": "^1.5.2",
    "history": "5.3.0",
    "humanize-duration": "^3.18.0",
    "immutable": "^3.8.1",
    "iso-639-1": "^1.2.4",
    "isomorphic-fetch": "^2.2.1",
    "jju": "https://github.com/evansiroky/jju.git",
    "jszip": "^3.8.0",
    "jwt-decode": "^2.1.0",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "leaflet-textpath": "^1.2.3",
    "lodash": "^4.17.10",
    "logrocket": "^0.6.17",
    "markdown-to-jsx": "^7.1.9",
    "moment": "^2.29.4",
    "numeral": "2.0.4",
    "object-path": "^0.11.5",
    "polyline": "^0.2.0",
    "qs": "^6.16.1",
    "randomcolor": "^0.5.3",
    "rbush": "^2.0.1",
    "rc-slider": "9.7.5",
    "react": "18.3.1",
    "react-addons-shallow-compare": "^15.4.1",
